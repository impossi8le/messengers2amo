# messengers2amo — production environment template.
#
# Copy to `.env` in this directory (never commit it) and fill every value:
#   install -m 600 .env.example .env
#
# ALL VALUES BELOW ARE INTENTIONALLY EMPTY. Empty is not "disabled" for the
# required variables: the API refuses to start (see
# apps/api/src/platform/config.ts) and Compose refuses to render
# (POSTGRES_* use ${VAR:?...}).
#
# Rules:
#   * no secrets in Git, in issue trackers, in chat, or in this file;
#   * keep the file mode 0600 and owner root;
#   * values are read by Compose interpolation AND injected into the container
#     via `env_file`, so they must be single-line, without quotes and without
#     leading/trailing spaces;
#   * anything marked SECRET must be generated on the host, not invented:
#       openssl rand -hex 32

# ---------------------------------------------------------------------------
# Compose / image selection
# ---------------------------------------------------------------------------

# Tag of the built API image. Use the release tag, never `latest` in production.
IMAGE_TAG=

# Domain schema inside PostgreSQL. Must match ^[a-z_][a-z0-9_]{0,62}$.
# Read by the `migrate` service as M2A_SCHEMA.
M2A_SCHEMA=messengers2amo

# Schema the API reads from at runtime (media, operator, amoCRM and /metrics
# routes). The API defaults to `public` when this is empty, which does NOT
# contain the migrated tables — /metrics would then return 503. Keep it equal
# to M2A_SCHEMA.
DB_SCHEMA=messengers2amo

# ---------------------------------------------------------------------------
# PostgreSQL container (never published to the host)
# ---------------------------------------------------------------------------

POSTGRES_USER=
# SECRET. Must be URL-safe (A-Z a-z 0-9 . _ ~ -) because it is embedded in
# DATABASE_URL built by docker-compose.yml. A password containing @ : / ? # %
# will break the URL and the API will fail to connect.
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---------------------------------------------------------------------------
# Application database access
# ---------------------------------------------------------------------------

# Normally left EMPTY: docker-compose.yml builds it as
#   postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB
# Set it only when running the API outside Compose.
DATABASE_URL=

# ---------------------------------------------------------------------------
# HTTP server (apps/api/src/platform/config.ts)
# ---------------------------------------------------------------------------

# Container-internal listen port. Compose pins 3000; do not change without
# also changing the publish mapping and the nginx upstream.
PORT=

# Bind address inside the container. Compose pins 0.0.0.0 (loopback publish).
HOST=

# Session cookie lifetime, seconds. Default 28800 (8 h) when empty.
SESSION_TTL_SECONDS=

# 1/true/yes → Set-Cookie gets the Secure attribute. Keep enabled in production;
# the public entrypoint is HTTPS-only.
SECURE_COOKIES=true

# 1/true/yes → trust X-Forwarded-* from the reverse proxy. Required behind nginx.
TRUSTED_PROXY=true

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# SECRET. HMAC key for staff session cookies. Minimum 32 characters, else the
# API exits with session_secret_too_short. Rotating it invalidates all sessions.
SESSION_SECRET=

# SECRET. One-time bootstrap token for the first admin. Empty = bootstrap
# disabled. Clear it after the first admin exists.
ADMIN_BOOTSTRAP_TOKEN=

# SECRET. Bearer token for the internal CRM adapter routes
# (GET /api/v2/internal/crm/bindings, POST /api/v2/internal/crm/outbound).
# Empty disables the whole group: the paths then answer 404, not 401. This is a
# separate service identity; an operator session cookie never authorizes these
# routes. Generate with: openssl rand -hex 32
# The adapter must send it as `Authorization: Bearer <token>`.
INTERNAL_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# S3 / object storage for media (optional feature)
# Leave S3_BUCKET empty to disable the whole S3 block.
# ---------------------------------------------------------------------------

S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
# SECRET
S3_ACCESS_KEY_ID=
# SECRET
S3_SECRET_ACCESS_KEY=
# 1/true → path-style addressing (MinIO and most self-hosted gateways).
S3_FORCE_PATH_STYLE=true

# Public HTTPS origin of this API (no path/query). Required for Telegram files in
# amoCRM; the worker and API must share SESSION_SECRET and the same S3 bucket.
# Files stay private; CRM receives a signed, revocable application download URL.
AMOCRM_MEDIA_BASE_URL=
# Enable files on the explicitly scoped REST lead-capture connection. Requires
# existing amoCRM OAuth permission "Files access"; originals are stored by amoCRM.
# This does not register a Chats channel or enable outgoing Telegram messages.
AMOCRM_CAPTURE_FILES_ENABLED=false

# ---------------------------------------------------------------------------
# amoCRM integration (optional feature)
# Leave AMOCRM_CLIENT_ID empty to disable the whole amoCRM block.
# ---------------------------------------------------------------------------

AMOCRM_CLIENT_ID=
# SECRET
AMOCRM_CLIENT_SECRET=
# Must be the public HTTPS callback, e.g. https://messengers.example.com/<callback-path>
AMOCRM_REDIRECT_URI=
# Account subdomain only, e.g. example (without .amocrm.ru)
AMOCRM_ACCOUNT_DOMAIN=
# SECRET. Key material for the AES-256-GCM credential envelope (at least 16
# characters; hashed to a 32-byte key). Empty disables the OAuth routes: no
# cipher is created, so tokens cannot be stored. Generate with:
#   openssl rand -hex 32
AMOCRM_TOKEN_KEY=
# Company id the integration belongs to. Empty defaults to `default`.
AMOCRM_COMPANY_ID=
# SECRET. One-time token allowing the OAuth flow before any staff account
# exists. Empty disables that bootstrap path; an admin session is then required.
AMOCRM_SETUP_TOKEN=

# ---------------------------------------------------------------------------
# Telegram channel (optional feature)
# Leave TELEGRAM_BOT_TOKEN empty to disable the whole Telegram block.
# ---------------------------------------------------------------------------

# SECRET
TELEGRAM_BOT_TOKEN=
# SECRET. Value of the X-Telegram-Bot-Api-Secret-Token header expected on webhook calls.
TELEGRAM_WEBHOOK_SECRET=
# Override only for a local Bot API server. Default https://api.telegram.org.
TELEGRAM_API_BASE=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API channel (optional feature)
# Leave WHATSAPP_APP_SECRET, WHATSAPP_ACCESS_TOKEN or WHATSAPP_PHONE_NUMBER_ID
# empty to disable the whole block; the webhook route then answers 503.
# ---------------------------------------------------------------------------

# SECRET. Meta app secret; X-Hub-Signature-256 is verified against it.
WHATSAPP_APP_SECRET=
# SECRET. System-user access token used for outbound messages.
WHATSAPP_ACCESS_TOKEN=
# Phone number id from the WhatsApp Business account.
WHATSAPP_PHONE_NUMBER_ID=
# SECRET. hub.verify_token expected by the GET subscription handshake. Empty
# disables the handshake: every GET answers 403, while POST webhooks still work.
WHATSAPP_VERIFY_TOKEN=
# Override only for a local Graph API emulator. Default https://graph.facebook.com/v21.0.
WHATSAPP_API_BASE=

# ---------------------------------------------------------------------------
# MAX bot channel (optional feature)
# Leave MAX_ACCESS_TOKEN or MAX_WEBHOOK_SECRET empty to disable the whole block.
# ---------------------------------------------------------------------------

# SECRET. Bot access token used for outbound messages.
MAX_ACCESS_TOKEN=
# SECRET. Value of the X-Max-Bot-Api-Secret header expected on webhook calls.
MAX_WEBHOOK_SECRET=
# Override only for a local MAX API emulator. Default https://platform-api2.max.ru.
MAX_API_BASE=

# ---------------------------------------------------------------------------
# VK community Callback API channel (optional feature)
# Leave any of these empty to disable the whole block; the route then answers 503.
# ---------------------------------------------------------------------------

# Numeric community (group) id.
VK_GROUP_ID=
# SECRET. Community access token used for outbound messages.
VK_ACCESS_TOKEN=
# SECRET. Shared secret from the Callback API settings, checked on every event.
VK_SECRET=
# SECRET. String returned verbatim on the GET type=confirmation handshake.
VK_CONFIRMATION_CODE=
# Override only for a local VK API emulator. Default https://api.vk.com.
VK_API_BASE=
# API version sent with outbound calls. Default 5.199.
VK_API_VERSION=

# ---------------------------------------------------------------------------
# Outbound gate
# ---------------------------------------------------------------------------

# 1/true/yes → allow sending to external providers. Keep 0/false/empty during
# deployment and the rollback rehearsal; enable only after smoke checks pass.
OUTBOUND_ENABLED=false
OUTBOUND_MODE=pilot
# Required together when OUTBOUND_ENABLED=true and mode=pilot. Leave disabled until scoped acceptance.
OUTBOUND_PILOT_COMPANY_ID=
OUTBOUND_PILOT_CONNECTION_ID=
OUTBOUND_PILOT_BINDING_EPOCH=
OUTBOUND_PILOT_CONVERSATION_ID=
OUTBOUND_PILOT_ACTIVATED_AFTER=

# SECRET. Bearer token for GET /metrics. Empty disables the route entirely
# (requests then get 404, not 401).
# Generate with: openssl rand -hex 24
# The scraper must send it as `Authorization: Bearer <token>`; never put it in
# a URL or query string. The application logger redacts `token`/`authorization`
# keys and nginx does not log request headers, so it does not reach the logs.
# Rotating it requires `docker compose -p messengers2amo up -d api` and the same
# change in the Prometheus credentials file.
METRICS_TOKEN=

# Outbox worker identity and poll interval (milliseconds). WORKER_ID defaults
# to `worker-<pid>` when empty; WORKER_INTERVAL_MS defaults to 1000.
WORKER_ID=worker-1
WORKER_INTERVAL_MS=1000
# Lease held by the worker while it owns a job, milliseconds. Empty uses the
# code default (60000). Must exceed the slowest provider call; a lease that is
# too short lets a second worker pick up the same job.
WORKER_LEASE_MS=
