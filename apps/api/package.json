{
  "name": "@internal/messenger-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "readiness": "node src/readiness-cli.ts",
    "migrate": "node src/migrate-cli.ts"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "9.13.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "typescript": "7.0.2"
  }
}
