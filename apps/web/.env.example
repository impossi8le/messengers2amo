# Базовый путь к внутреннему API шлюза. Секретов здесь нет:
# авторизация выполняется серверной сессией (cookie), токены не хранятся во фронтенде.
VITE_API_BASE_URL=/api

# Подсказка интерфейсу, какую роль показывать (read|send|manage|admin).
# Это только видимость кнопок: права проверяет сервер. Пустое значение —
# админские действия скрыты.
VITE_OPERATOR_ROLE=

# Компания по умолчанию для формы входа. Подставляется в поле «Компания»,
# чтобы оператор не вводил её вручную. Не секрет; пустое значение — поле пустое.
VITE_OPERATOR_COMPANY_ID=
